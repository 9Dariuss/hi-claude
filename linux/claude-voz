#!/usr/bin/env bash
# Abre (o se une a) la sesión de Claude que controla Oye Claude.
# Úsalo en lugar de `claude` cuando quieras poder hablarle a esa terminal:
#   cd ~/mi-proyecto && claude-voz
# Los argumentos extra se pasan a claude solo si la sesión es nueva.
set -euo pipefail
SESSION="${OYE_CLAUDE_SESSION:-claude}"

if tmux has-session -t "$SESSION" 2>/dev/null; then
    exec tmux attach-session -t "$SESSION"
fi
exec tmux new-session -s "$SESSION" -c "$PWD" claude "$@"
