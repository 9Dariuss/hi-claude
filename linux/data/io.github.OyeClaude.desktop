[Desktop Entry]
Type=Application
Name=Oye Claude
GenericName=Asistente de código
Comment=Claude Code en una ventana, con entrada por voz
Exec=@BIN@ %f
Icon=io.github.OyeClaude
Terminal=false
Categories=Development;Utility;
Keywords=claude;ai;ia;voz;voice;code;
StartupWMClass=io.github.OyeClaude
Actions=voice;

[Desktop Action voice]
Name=Hablar con Claude
Exec=@BIN@ --voice
